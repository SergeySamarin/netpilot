{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPilot",
  "version": "0.1.2",
  "identifier": "com.netpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetPilot",
        "visible": false,
        "width": 920,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sergey Samarin",
    "shortDescription": "NetPilot: управление обходом блокировок",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMTQzM0I4QTMzNjQyRDkKUldUWlFqYWp1RE1VWUk5OGcvWkV4d3NIb0ZRUWRQdk5jNmltQU15TU9FNWhKZ0NadnhaSmxTWXEK",
      "endpoints": [
        "https://github.com/SergeySamarin/netpilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
